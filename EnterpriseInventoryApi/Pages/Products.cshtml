@page
@model EnterpriseInventoryApi.Pages.ProductsModel
@inject JsonLocalizer L
@{
    ViewData["Title"] = "Panou de Inventar";
}

<link rel="stylesheet" href="~/css/general.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

<div class="app-wrapper">
    @await Html.PartialAsync("~/Pages/Shared/_Sidebar.cshtml")

    <div class="main-content">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h2 fw-bold text-dark mb-1">@L["ProductsTitle"]</h1>
                <p class="text-muted mb-0">@L["ProductsSubtitle"]</p>
            </div>
            <div>
                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-semibold">
                    <i class="bi bi-circle-fill small me-1"></i> @L["SystemActive"]
                </span>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-12 col-md-4">
                <div class="stat-card p-4 rounded-4 shadow-sm border-0 bg-white h-100">
                    <div class="d-flex align-items-center">
                        <div class="icon-box bg-primary-subtle text-primary rounded-3 p-3 me-3">
                            📦
                        </div>
                        <div>
                            <span class="d-block text-muted small fw-medium">@L["TotalProducts"]</span>
                            <h3 class="fw-bold mb-0 text-dark">@Model.TotalProductsCount</h3>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="stat-card p-4 rounded-4 shadow-sm border-0 bg-white h-100">
                    <div class="d-flex align-items-center">
                        <div class="icon-box bg-success-subtle text-success rounded-3 p-3 me-3">
                            💰
                        </div>
                        <div>
                            <span class="d-block text-muted small fw-medium">@L["AverageUnitPrice"]</span>
                            <h3 class="fw-bold mb-0 text-dark">
                                @Model.AverageUnitPrice.ToString("N2") LEI
                            </h3>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="stat-card p-4 rounded-4 shadow-sm border-0 bg-white h-100">
                    <div class="d-flex align-items-center">
                        <div class="icon-box bg-warning-subtle text-warning rounded-3 p-3 me-3">
                            ⚡
                        </div>
                        <div>
                            <span class="d-block text-muted small fw-medium">@L["ApiStatus"]</span>
                            <h3 class="fw-bold mb-0 text-dark">@L["Online"]</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <div class="card-header bg-white py-3 px-4 border-bottom border-light d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <h5 class="mb-0 fw-bold text-dark">@L["ProductCatalog"]</h5>

                <form method="get" class="d-flex align-items-center gap-2">
                    <div class="input-group input-group-sm">
                        <input type="text" name="SearchQuery" value="@Model.SearchQuery" class="form-control rounded-start-pill px-3" placeholder="@L["SearchProductsPlaceholder"]" style="min-width: 240px;">
                        <button class="btn btn-outline-primary px-3" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                        @if (!string.IsNullOrEmpty(Model.SearchQuery))
                        {
                            <a href="/Index" class="btn btn-outline-secondary rounded-end-pill px-3" title="@L["ResetSearch"]">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        }
                    </div>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-secondary">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>@L["ProductName"]</th>
                            <th>SKU</th>
                            <th>
                                <div class="d-flex align-items-center gap-2">
                                    <span>@L["UnitPriceColumn"]</span>
                                    <div class="btn-group btn-group-sm">
                                        <a href="/Products?SortOrder=price_asc&SearchQuery=@Model.SearchQuery" class="btn btn-outline-secondary py-0 px-1 @(Model.SortOrder == "price_asc" ? "active bg-secondary text-white" : "")" title="@L["SortAscending"]">
                                            <i class="bi bi-arrow-up"></i>
                                        </a>
                                        <a href="/Products?SortOrder=price_desc&SearchQuery=@Model.SearchQuery" class="btn btn-outline-secondary py-0 px-1 @(Model.SortOrder == "price_desc" ? "active bg-secondary text-white" : "")" title="@L["SortDescending"]">
                                            <i class="bi bi-arrow-down"></i>
                                        </a>
                                    </div>
                                </div>
                            </th>
                            <th class="text-end pe-4">@L["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Products.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">@L["NoProductsFound"]</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var product in Model.Products)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-secondary">#@product.Id</td>
                                    <td class="fw-bold text-dark">@product.Name</td>
                                    <td>
                                        <span class="badge bg-light text-dark font-monospace border">@product.SKU</span>
                                    </td>
                                    <td class="fw-semibold text-success">@product.UnitPrice.ToString("N2") LEI</td>
                                    <td class="text-end pe-4">
                                        <a href="/Details/@product.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">@L["Details"]</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Navigare pagini inventar" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="/Products?CurrentPage=@(Model.CurrentPage - 1)&SearchQuery=@Model.SearchQuery&SortOrder=@Model.SortOrder">@L["PaginationPrevious"]</a>
                    </li>

                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" href="/Products?CurrentPage=@i&SearchQuery=@Model.SearchQuery&SortOrder=@Model.SortOrder">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="/Products?CurrentPage=@(Model.CurrentPage + 1)&SearchQuery=@Model.SearchQuery&SortOrder=@Model.SortOrder">@L["PaginationNext"]</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>