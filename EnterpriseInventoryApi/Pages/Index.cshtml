@page
@model EnterpriseInventoryApi.Pages.IndexModel
@inject JsonLocalizer L
@{
    ViewData["Title"] = "Panou Principal";
}

<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

<div class="app-wrapper">
    @await Html.PartialAsync("~/Pages/Shared/_Sidebar.cshtml")

    <div class="main-content">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h2 fw-bold text-dark mb-1">@L["WelcomeTitle"]</h1>
                <p class="text-muted mb-0">@L["WelcomeSubtitle"]</p>
            </div>
            <div>
                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-semibold">
                    <i class="bi bi-circle-fill small me-1"></i> @L["SystemActive"]
                </span>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-12 col-md-4">
                <div class="stat-card p-4 rounded-4 shadow-sm border-0 bg-white h-100">
                    <div class="d-flex align-items-center">
                        <div class="icon-box bg-primary-subtle text-primary rounded-3 p-3 me-3">
                            📦
                        </div>
                        <div>
                            <span class="d-block text-muted small fw-medium">@L["TotalProductsCatalog"]</span>
                            <h3 class="fw-bold mb-0 text-dark">@Model.TotalProductsCount</h3>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="stat-card p-4 rounded-4 shadow-sm border-0 bg-white h-100">
                    <div class="d-flex align-items-center">
                        <div class="icon-box bg-success-subtle text-success rounded-3 p-3 me-3">
                            💰
                        </div>
                        <div>
                            <span class="d-block text-muted small fw-medium">@L["AverageUnitPrice"]</span>
                            <h3 class="fw-bold mb-0 text-dark">
                                @Model.AverageUnitPrice.ToString("N2") LEI
                            </h3>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="stat-card p-4 rounded-4 shadow-sm border-0 bg-white h-100">
                    <div class="d-flex align-items-center">
                        <div class="icon-box bg-warning-subtle text-warning rounded-3 p-3 me-3">
                            ⚡
                        </div>
                        <div>
                            <span class="d-block text-muted small fw-medium">@L["DatabaseConnection"]</span>
                            <h3 class="fw-bold mb-0 text-dark">SQL Server</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-8">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <h5 class="fw-bold text-dark mb-3">@L["QuickNavigation"]</h5>
                    <p class="text-muted small mb-4">@L["QuickNavigationSubtitle"]</p>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <a href="/Products" class="text-decoration-none">
                                <div class="p-3 border rounded-3 bg-light-subtle hover-shadow transition d-flex align-items-center">
                                    <div class="bg-primary text-white rounded-2 p-2 me-3">
                                        <i class="bi bi-box-seam fs-5"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0">@L["ManageProducts"]</h6>
                                        <small class="text-muted">@L["ViewFullCatalog"]</small>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-sm-6">
                            <a href="/Warehouses" class="text-decoration-none">
                                <div class="p-3 border rounded-3 bg-light-subtle hover-shadow transition d-flex align-items-center">
                                    <div class="bg-success text-white rounded-2 p-2 me-3">
                                        <i class="bi bi-building fs-5"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0">@L["MenuWarehouses"]</h6>
                                        <small class="text-muted">@L["MonitorLocations"]</small>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-sm-6">
                            <a href="/Orders" class="text-decoration-none">
                                <div class="p-3 border rounded-3 bg-light-subtle hover-shadow transition d-flex align-items-center">
                                    <div class="bg-warning text-dark rounded-2 p-2 me-3">
                                        <i class="bi bi-cart-check fs-5"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0">@L["ActiveOrders"]</h6>
                                        <small class="text-muted">@L["TrackDeliveries"]</small>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-sm-6">
                            <a href="/Customers" class="text-decoration-none">
                                <div class="p-3 border rounded-3 bg-light-subtle hover-shadow transition d-flex align-items-center">
                                    <div class="bg-info text-white rounded-2 p-2 me-3">
                                        <i class="bi bi-people fs-5"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0">@L["MenuCustomers"]</h6>
                                        <small class="text-muted">@L["BusinessPartners"]</small>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="fw-bold text-dark mb-3">@L["SystemStatusTitle"]</h5>
                        <ul class="list-unstyled text-muted small mb-0">
                            <li class="mb-2 d-flex justify-content-between">
                                <span>@L["ApiVersion"]</span>
                                <strong class="text-dark">v1.0.0</strong>
                            </li>
                            <li class="mb-2 d-flex justify-content-between">
                                <span>@L["Environment"]</span>
                                <strong class="text-dark">Development</strong>
                            </li>
                            <li class="mb-2 d-flex justify-content-between">
                                <span>@L["Framework"]</span>
                                <strong class="text-dark">.NET 8 / Razor</strong>
                            </li>
                        </ul>
                    </div>
                    <div class="mt-4 pt-3 border-top">
                        <span class="badge bg-primary-subtle text-primary w-100 py-2 rounded-pill fw-semibold">
                            @L["AllServicesRunningNormal"]
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>